{
  "name": "barber-linderos-tooling",
  "private": true,
  "version": "0.1.0",
  "description": "Herramientas de especificación del refactor; la aplicación actual permanece en backend/.",
  "engines": {
    "node": ">=22.12.0 <23",
    "npm": ">=10 <11"
  },
  "scripts": {
    "spec": "openspec",
    "spec:validate": "openspec validate --all --strict --no-interactive",
    "spec:list": "openspec list",
    "contract:generate": "node tools/refactor/generate-contract.cjs",
    "contract:validate": "node tools/refactor/generate-contract.cjs --check",
    "contract:characterize": "node tools/refactor/characterize.cjs",
    "db:generate": "node tools/refactor/mysql/generate.cjs",
    "db:check": "node tools/refactor/mysql/generate.cjs --check",
    "db:transfer": "node tools/refactor/mysql/transfer.cjs",
    "db:seed": "node tools/refactor/mysql/fixture.cjs",
    "db:rehearse": "node tools/refactor/mysql/rehearsal.cjs",
    "db:rehearse-copy": "node tools/refactor/mysql/rehearse-copy.cjs",
    "api:test": "node tools/refactor/php/test.cjs",
    "api:contract": "node tools/refactor/php/contract.cjs",
    "api:contract-check": "node tools/refactor/php/contract.cjs --check",
    "api:agenda-test": "node tools/refactor/php/agenda-test.cjs",
    "api:events-test": "node tools/refactor/php/events-test.cjs",
    "api:events-browser": "node tools/refactor/php/events-browser.cjs",
    "api:clients-test": "node tools/refactor/php/clients-test.cjs",
    "api:files-test": "node tools/refactor/php/files-test.cjs",
    "api:commerce-test": "node tools/refactor/php/commerce-test.cjs",
    "api:inventory-test": "node tools/refactor/php/inventory-test.cjs",
    "api:notifications-test": "node tools/refactor/php/notifications-test.cjs",
    "api:ai-test": "node tools/refactor/php/ai-test.cjs",
    "api:business-test": "node tools/refactor/php/business-test.cjs",
    "web:install": "node tools/refactor/web/run.cjs ci",
    "web:build": "node tools/refactor/web/run.cjs run build",
    "web:typecheck": "node tools/refactor/web/run.cjs run typecheck",
    "web:test": "node tools/refactor/web/run.cjs run test",
    "web:client-test": "node tools/refactor/web/run.cjs run test:client",
    "web:staff-test": "node tools/refactor/web/run.cjs run test:staff",
    "api:operations-test": "node tools/refactor/php/operations-test.cjs",
    "hosting:package": "node tools/refactor/hosting/package.mjs",
    "hosting:test": "node tools/refactor/hosting/test.mjs",
    "hosting:apache-test": "node tools/refactor/hosting/apache-test.mjs",
    "db:mariadb-generate": "node tools/refactor/mariadb/generate.cjs",
    "db:mariadb-check": "node tools/refactor/mariadb/generate.cjs --check",
    "api:users-test": "node tools/refactor/php/users-test.cjs"
  },
  "devDependencies": {
    "@apidevtools/swagger-parser": "13.0.0",
    "@fission-ai/openspec": "1.15.0",
    "mysql2": "3.24.6"
  }
}
