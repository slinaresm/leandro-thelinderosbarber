PORT=8080
JWT_SECRET=change_this_super_secret_in_production
JWT_EXPIRES_IN=7d
BUSINESS_OPEN_HOUR=9
BUSINESS_CLOSE_HOUR=22
SLOT_STEP_MINUTES=60

# ---- Base de datos ----
# DB_DRIVER=sqlite (default, dev) | postgres (produccion)
DB_DRIVER=sqlite
# Solo si DB_DRIVER=postgres:
DATABASE_URL=postgres://barber:barber@localhost:5432/barber_linderos
PG_SSL=false

# ---- Notificaciones por email (opcional) ----
# Si se dejan vacios, el sistema funciona en modo "simulado" (loguea y
# registra en la tabla notifications, sin enviar de verdad).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Barber Linderos <no-reply@barberlinderos.cl>"
NOTIFICATIONS_ENABLED=true

# ---- WhatsApp ----
# Numero usado por el boton de click-to-chat (wa.me) del frontend.
WHATSAPP_BUSINESS_NUMBER=56900000000
# Si se completan estas dos, se activa el envio real via WhatsApp Cloud API
# (Meta) para confirmaciones y recordatorios. Si se dejan vacias, queda simulado.
WHATSAPP_CLOUD_API_TOKEN=
WHATSAPP_CLOUD_PHONE_ID=

# ---- Uploads ----
UPLOADS_DIR=uploads
MAX_UPLOAD_MB=8

# ---- IA (Gemini, nivel gratuito) ----
# Sin esta key, "leer factura" en el panel admin y el asistente de clientes
# responden con un error claro en vez de fallar de forma confusa.
# Key gratuita (sin tarjeta) en https://aistudio.google.com/apikey.
# Nota: en el nivel gratuito, Google puede usar el contenido enviado para
# mejorar sus productos (a diferencia de un plan pagado). Evita subir facturas
# con datos muy sensibles si eso te preocupa.
GEMINI_API_KEY=
GEMINI_MODEL_INVOICE=gemini-3.6-flash
GEMINI_MODEL_CHAT=gemini-3.5-flash-lite

# ---- Pagos: Mercado Pago (Checkout Pro) ----
# Access Token de TU cuenta de Mercado Pago (Panel de desarrolladores > Tus
# integraciones > credenciales). Usa el Access Token de PRUEBA mientras
# desarrollas (paga con tarjetas de prueba de Mercado Pago, sin cobrar dinero
# real) y el de PRODUCCION cuando quieras cobrar de verdad — el dinero llega
# directo a tu cuenta de Mercado Pago en ambos casos (de prueba en integracion,
# real en produccion). Sin este token, la compra en la tienda responde con un
# error claro.
MP_ACCESS_TOKEN=
# URL publica donde corre este backend (Mercado Pago redirige y notifica aqui).
# En desarrollo local deja el default; en produccion usa tu dominio real
# (el webhook de confirmacion de pago solo funciona si es accesible desde
# internet, no localhost).
BACKEND_PUBLIC_URL=http://localhost:8080

# Production requires HTTPS and an unpredictable JWT_SECRET (32+ characters).
NODE_ENV=development
SITE_ORIGIN=http://localhost:8080
# Set only when behind this many trusted reverse proxies:
# TRUST_PROXY_HOPS=1
