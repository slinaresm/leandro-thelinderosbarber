{
  "name": "barber-linderos-web",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.22.0 <23"
  },
  "scripts": {
    "assets": "node scripts/assets.mjs",
    "dev": "npm run assets && react-router dev --host 127.0.0.1",
    "build": "npm run assets && react-router build",
    "typecheck": "react-router typegen && tsc --noEmit",
    "test": "node ../tools/refactor/web/test.cjs",
    "test:client": "node ../tools/refactor/web/test.cjs --client",
    "test:staff": "node ../tools/refactor/web/test.cjs --staff"
  },
  "dependencies": {
    "isbot": "5.1.38",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-router": "8.5.1"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@react-router/dev": "8.5.1",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "typescript": "7.0.2",
    "vite": "8.3.5"
  }
}
