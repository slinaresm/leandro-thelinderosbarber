APP_NAME="Barber Linderos API"
APP_ENV=local
APP_KEY=
APP_DEBUG=false
APP_URL=http://localhost:8081
SITE_ORIGIN=http://localhost:8081
APP_LOCALE=es
APP_FALLBACK_LOCALE=es
# Ruta real del DocumentRoot, obligatoria para operations:run.
# HOSTING_PUBLIC_ROOT=/home/cuenta/public_html/staging
LOG_CHANNEL=single
LOG_LEVEL=warning
# Perfil local histórico MySQL; para SoluciónHost usar mariadb y su puerto/base.
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=33384
DB_DATABASE=barber_api_dev
DB_USERNAME=
DB_PASSWORD=
CACHE_STORE=database
SESSION_DRIVER=array
QUEUE_CONNECTION=sync
MAIL_MAILER=log
JWT_ACTIVE_KID=key-1
JWT_KEYS={}
JWT_ISSUER=barber-linderos
JWT_AUDIENCE=barber-linderos-web

# PRIVATE_PHOTOS_ROOT=C:/ruta/privada/client-photos
# LEGACY_UPLOADS_ROOT=C:/copia/privada/uploads

# CATALOG_IMAGES_ROOT=
# LEGACY_CATALOG_UPLOADS_ROOT=

# INVOICE_FILES_ROOT=
# LEGACY_INVOICE_UPLOADS_ROOT=

NOTIFICATION_EMAIL_MODE=simulate
NOTIFICATION_WHATSAPP_MODE=simulate
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM=
# SMTP_SCHEME=smtp
# WHATSAPP_CLOUD_API_TOKEN=
# WHATSAPP_CLOUD_PHONE_ID=
# WHATSAPP_GRAPH_VERSION=
# WHATSAPP_TEMPLATE_LANGUAGE=es_CL
# WHATSAPP_TEMPLATE_CONFIRMATION=
# WHATSAPP_TEMPLATE_REMINDER_24H=
# WHATSAPP_TEMPLATE_REMINDER_2H=

AI_MODE=disabled
