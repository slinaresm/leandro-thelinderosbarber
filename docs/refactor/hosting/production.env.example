# Plantilla privada: sustituir dominio, rutas y claves. No publicar este archivo.
APP_NAME="Barber Linderos API"
APP_ENV=production
APP_DEBUG=false
APP_KEY=
APP_URL=https://linderosbarber.cl
SITE_ORIGIN=https://linderosbarber.cl
HOSTING_PUBLIC_ROOT=/home/leakmcl/public_html/linderosbarber.cl
APP_MAINTENANCE_DRIVER=file
APP_LOCALE=es
APP_FALLBACK_LOCALE=es
LOG_CHANNEL=single
LOG_LEVEL=warning
DB_CONNECTION=mariadb
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=leakmcl_linderos
DB_USERNAME=leakmcl_linderos_usr
DB_PASSWORD=
CACHE_STORE=database
DB_CACHE_CONNECTION=mariadb
DB_CACHE_LOCK_CONNECTION=mariadb
SESSION_DRIVER=array
QUEUE_CONNECTION=sync
JWT_ACTIVE_KID=key-1
JWT_KEYS={}
JWT_ISSUER=barber-linderos
JWT_AUDIENCE=barber-linderos-web
PRIVATE_PHOTOS_ROOT=/home/leakmcl/apps/linderosbarber-data/photos
CATALOG_IMAGES_ROOT=/home/leakmcl/apps/linderosbarber-data/catalog
INVOICE_FILES_ROOT=/home/leakmcl/apps/linderosbarber-data/invoices
# Configurar copias verificadas si hay archivos históricos; no apuntar al legado activo.
LEGACY_UPLOADS_ROOT=
LEGACY_CATALOG_UPLOADS_ROOT=
LEGACY_INVOICE_UPLOADS_ROOT=
NOTIFICATION_EMAIL_MODE=disabled
NOTIFICATION_WHATSAPP_MODE=disabled
AI_MODE=disabled
WHATSAPP_BUSINESS_NUMBER=
